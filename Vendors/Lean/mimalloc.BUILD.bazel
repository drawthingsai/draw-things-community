package(default_visibility = ["//visibility:public"])

# Lean's runtime/mimalloc.cpp compiles all of mimalloc (src/static.c) into its
# allocation fast path, as upstream does, so this target only supplies sources.
cc_library(
    name = "mimalloc",
    hdrs = glob(["include/**/*.h"]),
    defines = [
        "MI_MAX_ALIGN_SIZE=8",
        "MI_SECURE=0",
        "MI_STATIC_LIB",
        "MI_WIN_NOREDIRECT",
        "NDEBUG",
    ],
    includes = [
        "include",
        "src",
    ],
    linkstatic = True,
    textual_hdrs = glob([
        "src/**/*.c",
        "src/**/*.h",
    ]),
)
